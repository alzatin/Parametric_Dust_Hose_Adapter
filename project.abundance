        {
          "atomType": "Code",
          "x": 0.7507598784194529,
          "y": 0.16566265060240964,
          "uniqueID": "id-5910",
          "ioValues": [
            {
              "name": "sketch1",
              "ioValue": "__GEOMETRY_INPUT__"
            },
            {
              "name": "sketch2",
              "ioValue": "__GEOMETRY_INPUT__"
            }
          ],
          "codeVersion": 1,
          "code": "\n// Example Code\nconst Inputs = [\n  { inputName: \"sketch1\", type: \"geometry\", defaultValue: null },\n  { inputName: \"sketch2\", type: \"geometry\", defaultValue: null },\n];\n\nconst sketchSketch = library[sketch1].geometry[0].sketchOnPlane(\"XY\")\n\nlet planex = replicad.makePlane(\"XY\")\nconsole.log(library[sketch2].plane)\nconst sketchSketch2 = library[sketch2].geometry[0].sketchOnPlane(library[sketch2].plane)\n\n\n//let newPlane = replicad.makePlane()\nlet loftShape = sketchSketch.loftWith(\n  sketchSketch2, \n   {}, \n   false).shell(1,  (face) =>\n    face.inPlane(planex));\nlet cylObj = {\n  geometry: [loftShape],\n  dimension: \"3D\",\n  tags: [\"createdCylinder\"],\n  color: \"#A3CE5B\",\n  plane: null,\n  bom: []\n};\n\nreturn cylObj\n"
        },
