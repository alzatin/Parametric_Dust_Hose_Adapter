        {
          "atomType": "Code",
          "x": 0.6231003039513677,
          "y": 0.17771084337349397,
          "uniqueID": "id-5254",
          "ioValues": [
            {
              "name": "shape",
              "ioValue": "__GEOMETRY_INPUT__"
